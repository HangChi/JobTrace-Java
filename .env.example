# Spring Boot expects a JDBC URL. Do not commit real credentials.
JOBTRACE_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/jobtrace
JOBTRACE_DATABASE_USERNAME=jobtrace
JOBTRACE_DATABASE_PASSWORD=change-me

# Keep disabled until the legacy migration chain has an approved Flyway baseline.
JOBTRACE_FLYWAY_ENABLED=false

# Used later for the Better Auth -> Spring Security transition.
JOBTRACE_AUTH_BRIDGE_SECRET=replace-with-at-least-32-random-characters

