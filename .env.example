# Spring Boot expects a JDBC URL. Do not commit real credentials.
JOBTRACE_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/jobtrace
JOBTRACE_DATABASE_USERNAME=jobtrace
JOBTRACE_DATABASE_PASSWORD=jobtrace

# Keep disabled until the legacy migration chain has an approved Flyway baseline.
JOBTRACE_FLYWAY_ENABLED=false

# Disabled by default. Secrets are base64url-encoded random values of at least 32 bytes.
JOBTRACE_AUTH_BRIDGE_ENABLED=false
JOBTRACE_AUTH_BRIDGE_ISSUER=legacy-jobtrace
JOBTRACE_AUTH_BRIDGE_AUDIENCE=jobtrace-java
JOBTRACE_AUTH_BRIDGE_MAX_LIFETIME_SECONDS=30
JOBTRACE_AUTH_BRIDGE_CLOCK_SKEW_SECONDS=5
JOBTRACE_AUTH_BRIDGE_REPLAY_KEY_PREFIX=jobtrace:auth-bridge:replay
JOBTRACE_AUTH_BRIDGE_KEYS_0_ID=replace-with-current-key-id
JOBTRACE_AUTH_BRIDGE_KEYS_0_SECRET=replace-with-base64url-secret
JOBTRACE_AUTH_BRIDGE_KEYS_1_ID=replace-with-previous-key-id
JOBTRACE_AUTH_BRIDGE_KEYS_1_SECRET=replace-with-base64url-secret
JOBTRACE_REDIS_URL=redis://127.0.0.1:6379
